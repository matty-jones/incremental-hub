<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ cloud backup and device transfer are separate. Both whitelist display
  preferences only. Room pointers, restore journals, and WebView profile
  directories stay on the device. A transfer therefore cannot restore a native
  pointer without its WebView profile, or a profile without its pointer.
  Dynamic inspect profiles (app_webview_hub-inspect-*) are not listed; the
  include whitelist keeps them out. Backup rules have no wildcard.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="hub_display_preferences.xml" />

        <exclude domain="database" path="hub_database" />
        <exclude domain="database" path="hub_database-wal" />
        <exclude domain="database" path="hub_database-shm" />
        <exclude domain="database" path="hub_database-journal" />

        <exclude domain="sharedpref" path="hub_settings.xml" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />

        <exclude domain="file" path="restore-journals" />

        <exclude domain="root" path="app_webview" />
        <exclude domain="root" path="app_webview_hub-game-shark-incremental" />
        <exclude domain="root" path="app_webview_hub-game-trimps" />
        <exclude domain="root" path="app_webview_hub-game-synergism" />
        <exclude domain="root" path="app_webview_hub-game-fe000000" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="hub_display_preferences.xml" />

        <exclude domain="database" path="hub_database" />
        <exclude domain="database" path="hub_database-wal" />
        <exclude domain="database" path="hub_database-shm" />
        <exclude domain="database" path="hub_database-journal" />

        <exclude domain="sharedpref" path="hub_settings.xml" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />

        <exclude domain="file" path="restore-journals" />

        <exclude domain="root" path="app_webview" />
        <exclude domain="root" path="app_webview_hub-game-shark-incremental" />
        <exclude domain="root" path="app_webview_hub-game-trimps" />
        <exclude domain="root" path="app_webview_hub-game-synergism" />
        <exclude domain="root" path="app_webview_hub-game-fe000000" />
    </device-transfer>
</data-extraction-rules>
