<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ cloud backup and device transfer are separate. Both whitelist display
  preferences only. Room pointers, restore journals, and WebView profile
  directories stay on the device because they are not included. A transfer
  therefore cannot restore a native pointer without its WebView profile, or a
  profile without its pointer. An exclude is valid only inside an included
  path, so those directories are not listed. Backup rules have no wildcard.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="hub_display_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="hub_display_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
