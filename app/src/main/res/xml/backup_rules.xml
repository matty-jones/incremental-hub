<?xml version="1.0" encoding="utf-8"?>
<!--
  API 30 Auto Backup. One include switches the default to "only these files".
  Room, restore journals, and WebView profiles are left out because they are
  not included. An exclude is valid only inside an included path, so listing
  them separately is rejected by release lint and is not required.
  The .ihub archive is the recovery contract. Display zoom is the only
  preference kept.
-->
<full-backup-content>
    <include domain="sharedpref" path="hub_display_preferences.xml" />
</full-backup-content>
